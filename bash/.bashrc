# Bash Variables.
PS1='┌─[\u]──[\w]\n└─╼ '
HISTSIZE=-1
HISTFILESIZE=-1

# Aliases.
alias blender='~/projects/blender/build/bin/blender'
alias blender4.1='~/files/blender/builds/blender-4.1.0-linux-x64/blender'
alias blender4.2='~/files/blender/builds/blender-4.2.0-linux-x64/blender'
alias blender4.3='~/files/blender/builds/blender-4.3.2-linux-x64/blender'
alias blender4.4='~/files/blender/builds/blender-4.4.0-linux-x64/blender'
alias blender4.5='~/files/blender/builds/blender-4.5.3-linux-x64/blender'
alias blender5.0='~/files/blender/builds/blender-5.0.1-linux-x64/blender'
alias blender5.1='~/files/blender/builds/blender-5.1.0-linux-x64/blender'
alias blender5.2='~/files/blender/builds/blender-5.2.2-linux-x64/blender'
alias ls='ls --color=auto'
alias v='nvim'

